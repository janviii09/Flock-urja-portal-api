          "zone",
          "circle",
          "division",
          "subdivision",
          "substation",
          "feeder",
          "dt"
        ],
        "title": "HierarchyLevel",
        "description": "Network hierarchy levels, top to bottom.\n\nObserved breadcrumb pattern on meter detail page:\nZone > Circle > Division > Subdivision > Substation > Feeder > DT"
      },
      "HierarchyNode": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "level": {
            "$ref": "#/components/schemas/HierarchyLevel"
          },
          "parent_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Code"
          },
          "quality_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quality Flags"
