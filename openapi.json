{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "description": "Clean, documented REST API wrapping the legacy Urja Meter Ops utility portal.\n\n### Key Capabilities:\n- **Meters List**: Query smart meters with cursor pagination and multi-parameter filters.\n- **Meter Detail**: Full nameplate, GPS coordinates, and 7-level hierarchy path (`Zone \u203a Circle \u203a Division \u203a Subdivision \u203a Substation \u203a Feeder \u203a DT`).\n- **Consumption**: 30-minute interval readings time series with date window filtering.\n- **Freshness Engine**: Per-resource TTLs, single-flight request coalescing, and stale-while-revalidate.\n- **Error Handling**: RFC 7807 Problem Details on all failure responses (`application/problem+json`).",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/meters": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "List smart meters with cursor pagination and filtering",
        "description": "Retrieves a paginated list of smart meters from the local store. Supports filtering by distribution transformer code, serial number, manufacturer, phase type, and installation status. Includes provenance and cache freshness metadata in the `meta` envelope.",
        "operationId": "list_meters_v1_meters_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque pagination cursor (meter_id to paginate after).",
              "examples": [
                "J100020"
              ],
              "title": "Cursor"
            },
            "description": "Opaque pagination cursor (meter_id to paginate after)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of meters to return per page (max 100).",
              "default": 20,
              "title": "Limit"
            },
            "description": "Number of meters to return per page (max 100)."
          },
          {
            "name": "dt_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Distribution Transformer code.",
              "examples": [
                "DT-001"
              ],
              "title": "Dt Code"
            },
            "description": "Filter by Distribution Transformer code."
          },
          {
            "name": "serial_no",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter serial number.",
              "examples": [
                "SE33962"
              ],
              "title": "Serial No"
            },
            "description": "Filter by meter serial number."
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by meter manufacturer (e.g. HPL, L&T, Secure).",
              "title": "Make"
            },
            "description": "Filter by meter manufacturer (e.g. HPL, L&T, Secure)."
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PhaseType"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by phase type (single or three).",
              "title": "Phase"
            },
            "description": "Filter by phase type (single or three)."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/InstallationStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation status (Installed, Faulty, Decommissioned).",
              "title": "Status"
            },
            "description": "Filter by installation status (Installed, Faulty, Decommissioned)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/nearby": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Spatial meter query with bounding-box prefilter and haversine distance",
        "description": "Finds smart meters within radius_km of a GPS coordinate using two-phase querying: bounding-box bounding filter in SQL followed by exact great-circle haversine calculation. Excludes Null Island (0,0) and records with missing coordinates.",
        "operationId": "get_meters_nearby_v1_meters_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Latitude in decimal degrees (-90 to 90).",
              "examples": [
                28.6139
              ],
              "title": "Lat"
            },
            "description": "Latitude in decimal degrees (-90 to 90)."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Longitude in decimal degrees (-180 to 180).",
              "examples": [
                77.209
              ],
              "title": "Lon"
            },
            "description": "Longitude in decimal degrees (-180 to 180)."
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 500.0,
              "exclusiveMinimum": 0.0,
              "description": "Search radius in kilometers (default 5.0 km, max 500 km).",
              "examples": [
                5.0
              ],
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Search radius in kilometers (default 5.0 km, max 500 km)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of nearby meters to return (default 20, max 100).",
              "examples": [
                20
              ],
              "default": 20,
              "title": "Limit"
            },
            "description": "Maximum number of nearby meters to return (default 20, max 100)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetersNearbyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Get detailed meter information",
        "description": "Retrieves complete details for a single smart meter, including nameplate attributes, GPS coordinates, and the reconstructed 7-level network hierarchy breadcrumb. If data in the local store is missing or stale, triggers a single-flight refresh from the portal. If portal refresh fails, serves stale store data (stale-while-revalidate).",
        "operationId": "get_meter_detail_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Get meter consumption time series",
        "description": "Retrieves 30-minute interval consumption readings (kWh, kVAh, voltage) for a meter. Supports date filtering via `from` and `to` query parameters. Applies freshness rules: recent readings (<24h old) have a 5-minute TTL; historical readings older than 24 hours are treated as immutable.",
        "operationId": "get_meter_consumption_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter readings starting from this timestamp (inclusive ISO-8601).",
              "title": "From"
            },
            "description": "Filter readings starting from this timestamp (inclusive ISO-8601)."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter readings up to this timestamp (inclusive ISO-8601).",
              "title": "To"
            },
            "description": "Filter readings up to this timestamp (inclusive ISO-8601)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum number of reading entries to return.",
              "default": 100,
              "title": "Limit"
            },
            "description": "Maximum number of reading entries to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Liveness check, portal connectivity, and sync status",
        "description": "Reports the operational health of the API service, upstream connectivity to the Urja Meter Ops legacy portal, and details of the most recent data sync run.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hierarchy": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Reconstructed 7-level network tree",
        "description": "Synthesizes the complete utility network hierarchy tree (Zone \u203a Circle \u203a Division \u203a Subdivision \u203a Substation \u203a Feeder \u203a DT) with deterministic repair rules: ID normalization, multiple parent tie-breaking, cycle breaking, and dangling ref detachment. No nodes are ever deleted.",
        "operationId": "get_hierarchy_v1_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyTreeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/nodes/{node_id}/children": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Direct children of a hierarchy node",
        "description": "Returns the immediate children of the specified hierarchy node code.",
        "operationId": "get_node_children_v1_nodes__node_id__children_get",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Node Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyNodeListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/nodes/{node_id}/subtree": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Subtree query using recursive CTE",
        "description": "Fetches all descendants of the specified hierarchy node using a recursive Common Table Expression (CTE) with depth guard.",
        "operationId": "get_node_subtree_v1_nodes__node_id__subtree_get",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Node Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchySubtreeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quality": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Network data quality defect report",
        "description": "Audits the network for data anomalies across hierarchy (orphans, cycles, multiple parents, dangling references, ID mismatches), meters (null island, missing nameplates), and consumption readings (monotonicity violations).",
        "operationId": "get_quality_v1_quality_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness check",
        "description": "Root liveness probe check.",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Data",
            "description": "Time series consumption readings ordered descending by timestamp."
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta",
            "description": "Cache freshness and origin metadata."
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "ConsumptionResponse",
        "description": "Response payload for GET /v1/meters/{id}/consumption."
      },
      "CursorPagination": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Opaque cursor token for fetching the next page."
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "description": "True if additional pages are available beyond this result set."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total number of records matching query filters in the store."
          }
        },
        "type": "object",
        "required": [
          "has_more",
          "total"
        ],
        "title": "CursorPagination",
        "description": "Cursor-based pagination envelope."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service health: 'ok' or 'degraded'."
          },
          "portal_reachable": {
            "type": "boolean",
            "title": "Portal Reachable",
            "description": "True if the legacy portal is accessible."
          },
          "last_sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncRun"
              },
              {
                "type": "null"
              }
            ],
            "description": "Details of the most recent synchronization job."
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta",
            "description": "Freshness metadata for the health evaluation."
          }
        },
        "type": "object",
        "required": [
          "status",
          "portal_reachable",
          "meta"
        ],
        "title": "HealthResponse",
        "description": "System health and upstream portal status."
      },
      "HierarchyLevel": {
        "type": "string",
